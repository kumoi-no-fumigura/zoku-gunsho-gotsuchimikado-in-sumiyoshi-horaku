   ],
   "text": "もの事",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "よる浪の音はかはらて住の江や松の緑そ霞そめぬる",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初春",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "とをき世の音をも見せて山となるちりのまかひに霞色哉",
   "kana": "",
   "speaker": "勝仁",
   "page": 1,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "西段へ",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "春の日の光りにのみはさもあらて霞に消る嶺のしら雪",
   "kana": "",
   "speaker": "政家",
   "page": 1,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "西段へ",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "しるへ遣し風の行東か花の香の匂ふ山路の鴬のこゑ",
   "kana": "",
   "speaker": "冬良",
   "page": 1,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶯",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "下もへの草葉数そふ程みへて縁りになりぬ野への潰雪",
   "kana": "",
   "speaker": "道興",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雪",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "一摘残す沢の若なはおのつから下行水や根をあらふらん",
   "kana": "",
   "speaker": "尚道",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若菜",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "冬と春と行かふ年の雪の枝にかたみにかほる梅の下風",
   "kana": "",
   "speaker": "尊応",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "梅かえにたくふ匂ひそ木にもあらす草にもあらぬ春風そ吹",
   "kana": "",
   "speaker": "実淳",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "青柳のかれ葉におもき雪に社音せぬ春の雨もしらされ",
   "kana": "",
   "speaker": "定胤",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "古郷の春にとも行天つ雁山より山の花にわかれて",
   "kana": "",
   "speaker": "宗綱",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰鷹",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "春風に行ゑもしらぬ花の香のいかて桜のなをのこるらん",
   "kana": "",
   "speaker": "豊道",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "吹よるも盛の花は難面てまつにみかへるはるの山かせ",
   "kana": "",
   "speaker": "実隆",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "蒼海のかさしの浪も匂ふらし磯山きくら春風そ吹",
   "kana": "",
   "speaker": "実香",
   "page": 2,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "見れはまつうちおとろきて木の本のまみゆきこの花盛哉",
   "kana": "",
   "speaker": "教国",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "逢ひにあひて花の盛は日も永く風も長閑き春の空哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "花の香は袖にとめこし夜半の月やとす影なく霞空哉",
   "kana": "",
   "speaker": "政為",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "よる浪の露置添て山吹の枝もたはゝに見ゆる岸影",
   "kana": "",
   "speaker": "一句当内侍",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "咲登るしるしそみゆる藤の花はふ木を波のみをつくしにて",
   "kana": "",
   "speaker": "宋世",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "人ならぬ春の別も今しはと折は柳やかたみならまし",
   "kana": "",
   "speaker": "為広",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三月尽",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "夕暮の露光りそふ卯花は籬も山の月かあらぬか",
   "kana": "",
   "speaker": "季種",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "思ひ寝にねられはせめて時鳥うつゝより聞夢にみてまし",
   "kana": "",
   "speaker": "元長",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "子児",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "誰里に又ゑくらん時鳥夜かれかほなる一声のそら",
   "kana": "",
   "speaker": "通世",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "子児",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "住吉のまつよもいはす時鳥月も西なる海をこととへ",
   "kana": "",
   "speaker": "基綱",
   "page": 3,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "子児",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "入相の鐘より出し夏の夜の月もや秋の暁のこゑ",
   "kana": "",
   "speaker": "公助",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "夏草の靡く末葉はうきなからさそはぬ水に五月雨の庭",
   "kana": "",
   "speaker": "雅俊",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "船そよる浪花田蓑の薄隠れ頼むともなき五月雨の頃",
   "kana": "",
   "speaker": "肖柏",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "住の紅や松にそかへる秋風ををのれ告てもとふ蛍かな",
   "kana": "",
   "speaker": "行仁",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二里",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "かき曇り夕立すなりなる神の音羽の山の瀧もとゝろに",
   "kana": "",
   "speaker": "宗祇",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "水のうへに幾日もあらぬ夏引の手引の糸の長き日くらし",
   "kana": "",
   "speaker": "宗長",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "蕨の音に歌とはしるし一葉ちる梢にあかぬ風のゆくゑも",
   "kana": "",
   "speaker": "勝仁",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初秋",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "思ひやる心をかして織女のけきの別れやなけきそふらん",
   "kana": "",
   "speaker": "雅俊",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕後朝",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "言のはの色添秋につくは山しれき恵みの露をみる哉",
   "kana": "",
   "speaker": "実隆",
   "page": 4,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "露",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "九重の都も秋は萩のはに軒端の山のあらしをそ聞",
   "kana": "",
   "speaker": "実淳",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "契りあれや鹿たちならす山陰の園の一木の本あらの萩",
   "kana": "",
   "speaker": "尊応",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "穂に出る秋待みても賤の男か尾花かりふく軒そみしかき",
   "kana": "",
   "speaker": "冬良",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "唐衣すそ野の花に宿とはて帰る袖をや虫は恨むる",
   "kana": "",
   "speaker": "基綱",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "虫",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "又よくにうづろひ行か棹鹿の臥ことゆる萩の花妻",
   "kana": "",
   "speaker": "宣胤",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "はる〳〵と馴ぬ都の旅にきていつくに宿をかりの鳴らん",
   "kana": "",
   "speaker": "教秀",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初雁",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "海遠く月をも西に仰きつゝつゝつゝつゝつゝつきつきつきつゝつゝつゝつきつ",
   "kana": "",
   "speaker": "季種",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "神も初めてさらめやは是そ此津守の浦に月そ更行",
   "kana": "",
   "speaker": "宋世",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "何事か思ひ残さむつく〳〵と隈なき月にむかふ夜な〳〵",
   "kana": "",
   "speaker": "句当内侍",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "みし事も聞しも今はあらぬよに是や昔の秋の夜の月",
   "kana": "",
   "speaker": "政家",
   "page": 5,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "秋は又照そふ月の習をも見わかぬ尤は春やわすれぬ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "ほのかにも在明の月の更るまて遠の里人歓うつなり",
   "kana": "",
   "speaker": "実香",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "あらしつる野分の路に夕霧の籬を頼宿もはかなし",
   "kana": "",
   "speaker": "宗綱",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "勇",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "露霜をなてぬきにしていとはやも折しる木々の唐錦哉",
   "kana": "",
   "speaker": "道興",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "紅のけちめ顕はす松か枝に木の葉むなしき時雨なるらん",
   "kana": "",
   "speaker": "為広",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "送りこし名残ハ猶や身にしまむ野にも山にも暮る秋風",
   "kana": "",
   "speaker": "政為",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春秋",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "住の江や色にはみへぬ松風の音に時雨て冬は来にけり",
   "kana": "",
   "speaker": "尚通",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "此頃は木のハ乱て夕時雨あらそひかぬる音の淋しさ",
   "kana": "",
   "speaker": "豊通",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "今も猶時西の雨の名残とて苦路を染てちる木葉哉",
   "kana": "",
   "speaker": "政家",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "定なき時雨に染し木葉とてちらてしとまる一枝もみす",
   "kana": "",
   "speaker": "元長",
   "page": 6,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "雪寒き尾上の嵐更る夜につかぬ鏡聞月の下いほ",
   "kana": "",
   "speaker": "尊応",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "一とをりふり来る霰はけしくて雨になる日そかつ長閑なる",
   "kana": "",
   "speaker": "改為",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霰",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "白妙の高嶺はそれか都迄雪吹をくれ比良の山風",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "問はやな冬籠にし槙の戸も雪の朝そこゝろみへける",
   "kana": "",
   "speaker": "勝仁",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "白雪の積れるうへは里人のふむ音もなきまへのたなみし",
   "kana": "",
   "speaker": "実淳",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "行かへりかきりはなきを暮はつと思へは年も老そかなしき",
   "kana": "",
   "speaker": "宗祇",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "つゝむへき故をもしらてあちきなく馴ぬ酒を洩しつる哉",
   "kana": "",
   "speaker": "采世",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初恋",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "覚束なはていゝならむ愚なる心ひとつにつゝむおもひは",
   "kana": "",
   "speaker": "尚通",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍意",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "しらせはと思ふ心を頼にてつゝむもいつを限なるらん",
   "kana": "",
   "speaker": "宗綱",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍意",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "さきの世の契りしらはやかゝ斗つれなかるへき報ひ有やと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不過応",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "沈ても此世にかへる罪しあれはあはて命のうきに絶なは",
   "kana": "",
   "speaker": "実淳",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不過応",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "よそにのみ闇の現もまたしらてはかなき夢に身をやそさん",
   "kana": "",
   "speaker": "実隆",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不過応",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "人は憂花の下紐春風の吹をも待ぬためし有世を",
   "kana": "",
   "speaker": "背拍",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不過応",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "にそにのみ思はぬよりは偽のうきをたにしる夕暮も哉",
   "kana": "",
   "speaker": "行仁",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不過応",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "ならはしの涙吹ほせ我思ひ今宵すき間の手枕の風",
   "kana": "",
   "speaker": "尊恵",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "行かへり後も頼まむ逢坂にたゝこのたひの鳥の音そうき",
   "kana": "",
   "speaker": "基綱",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁別恋",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "けさは猶うき暁の心さへ身を別れては誰れしたふらん",
   "kana": "",
   "speaker": "季種",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後朝恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "月は猶其よを残す国の中に人はかけせぬ床の淋しき",
   "kana": "",
   "speaker": "道興",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢不会恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "うかりつる別もこりぬ心をも見へはや人の夢の枕に",
   "kana": "",
   "speaker": "政為",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢不会恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "其まゝに後瀬もしらて一夜川渡るや何の夢路なるらん",
   "kana": "",
   "speaker": "為広",
   "page": 8,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢不会恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "はてはかく難面竜の有なからなかや一夜のあふの松原",
   "kana": "",
   "speaker": "宋世",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢不会恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "一今は又なけく泪やつゝまゝしみつの柏のたちし袂に",
   "kana": "",
   "speaker": "冬良",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢不過応",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "是も猶同し心にあらねはや忘らるゝ身ハ忘れさるらん",
   "kana": "",
   "speaker": "政家",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "流石又思ひや出ると計に問ぬ月日をおとろかさはや",
   "kana": "",
   "speaker": "教国",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "それをたにかそへて今は忍ふ哉驚かされて問し夜頃を",
   "kana": "",
   "speaker": "通世",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "たかかたに豊浦のしまの二心かけても浪に袖しほるらん",
   "kana": "",
   "speaker": "雅俊",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "島の音はよしはかる共つかへ行道はまよはむ心ならめや",
   "kana": "",
   "speaker": "為広",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "時分ていく代高砂住の江や梢にしるく松の通ぬらん",
   "kana": "",
   "speaker": "宗長",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "降うつむ雪に臥ても下折の声をは聞ぬ庭のなよ竹",
   "kana": "",
   "speaker": "教秀",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "竹",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "濁りなき流れの末に誘はれて猶水上の山そゆりしき",
   "kana": "",
   "speaker": "豊通",
   "page": 9,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "つくはねの絶ぬ流やみなの川渕も瀬になる恨みなるらん",
   "kana": "",
   "speaker": "公助",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "山人の己か手なるゝわさなれや渡すもかりの谷の柴橋",
   "kana": "",
   "speaker": "雅俊",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "成日へていつこへはてむ行末の山も七尾の八重のしら雲",
   "kana": "",
   "speaker": "玄清",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "古郷に通ふ夢路の関守や枕にちかき山風のこゑ",
   "kana": "",
   "speaker": "尚通",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "心たに浮世にとめぬ物ならは外に隔つる関はありとも",
   "kana": "",
   "speaker": "冬良",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "船出する追手もあれな浦遠き汐干の名残波風もなし",
   "kana": "",
   "speaker": "勝仁",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "遁ても此世の内はとにか〳〵に心にかなふ山すみやなき",
   "kana": "",
   "speaker": "政為",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "尋はや道有世をも松風に猶山ふかく人やすむらん",
   "kana": "",
   "speaker": "実淳",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "流れ行みつのゝ里の末みへて田面はるけき淀の川ふね",
   "kana": "",
   "speaker": "宣胤",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "捨はやの浮世の風のはけしさは倒たる嶺も聞やのとめん",
   "kana": "",
   "speaker": "為広",
   "page": 10,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "何かせむ今たに末の世語にたとへは残る其名ありとも",
   "kana": "",
   "speaker": "基綱",
   "page": 11,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "さま〳〵にかはりにて行光の後うかりしもとの身をも忘つゝ",
   "kana": "",
   "speaker": "教国",
   "page": 11,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "現には又もかへらぬ古へをうちぬる夢にみてそゑむ",
   "kana": "",
   "speaker": "一句当内侍",
   "page": 11,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夢",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "立登る朝日をみても波の底に和くけ初し光りをもしる",
   "kana": "",
   "speaker": "宗祇",
   "page": 11,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祇",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "むねのうちにやとしとゝめてむかふ哉鷲の嶺より出し月影",
   "kana": "",
   "speaker": "道興",
   "page": 11,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "釈教",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "神の代をかそへむとすれは海も浅く君を仰せは山も及はし",
   "kana": "",
   "speaker": "宋世",
   "page": 11,
   "pid": "nao-734026",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "覚",
   "kotobagaki": ""
  }
 ],
